# On Railway, reference the Postgres service variable instead:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}   (private network, no SSL needed)
# For local development use the PUBLIC proxy URL and set DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway
DATABASE_SSL=false

# Admin login
ADMIN_PASSWORD=change-me
# Random 32+ char string used to sign the login cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string

# Variants at or below this stock are flagged as low stock
LOW_STOCK_THRESHOLD=5

# Public address of this dashboard, used in uploaded photo links that the WhatsApp agent sends.
# Optional on Railway (detected automatically); set it if you use a custom domain.
# PUBLIC_BASE_URL=https://shop-admin-production.up.railway.app
